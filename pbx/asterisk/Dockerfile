# Local open-source PBX for Claude Phone (Asterisk, PJSIP)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends asterisk asterisk-core-sounds-en-gsm ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Config files (pjsip.conf, extensions.conf, rtp.conf, modules.conf, logger.conf)
# are generated by `claude-phone start` and mounted into /etc/asterisk.
CMD ["asterisk", "-f", "-U", "asterisk", "-G", "asterisk", "-vvv"]
